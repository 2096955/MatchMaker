  "tour": [
    {
      "order": 1,
      "title": "ETL Ingestion Flow",
      "description": "Vendor data arrives via S3 upload. EventBridge fires a PutObject rule that queues the event in SQS. The Lambda Worker (in VPC) dequeues, validates, and transforms the record. Valid records land in the S3 canonical sink (JSON-LD/Parquet) and DynamoDB; invalid records are routed to the S3 quarantine bucket.",
      "nodeIds": [
        "etl-eventbridge",
        "etl-sqs",
        "etl-lambda",
        "etl-validate",
        "etl-s3-sink",
        "etl-dynamodb"
      ]
    },
    {
      "order": 2,
      "title": "Match: Global Equity Prices (LSEG)",
      "description": "LSEG product 'Global Equity Prices' (LSEG-EQ-PX) ingested via EventBridge \u2192 ETL \u2192 matching engine. Retrieved 6 CDAO candidate(s).",
      "nodeIds": [
        "mds.lseg:5f56a026-c52a-5e7f-b0a9-7e9b8b5bc1e0",
        "etl-eventbridge",
        "match-a-parse",
        "match-b-semantic",
        "match-c-rank",
        "match-confidence-gate",
        "jpmorgan:data:cdao:concept:equity-prices",
        "jpmorgan:data:cdao:concept:fixed-income-prices",
        "jpmorgan:data:cdao:domain:market-data"
      ]
    },
    {
      "order": 3,
      "title": "Match: FX Spot and Forward Rates (SPGLOBAL)",
      "description": "S&P Global product 'FX Spot and Forward Rates' (SPG-FX) ingested via EventBridge \u2192 ETL \u2192 matching engine. Retrieved 6 CDAO candidate(s).",
      "nodeIds": [
        "mds.sandpglobal:92b2507d-0545-5097-ad1a-dd827e70cb9f",
        "etl-eventbridge",
        "match-a-parse",
        "match-b-semantic",
        "match-c-rank",
        "match-confidence-gate",
        "jpmorgan:data:cdao:concept:fx-rates",
        "jpmorgan:data:cdao:domain:market-data",
        "jpmorgan:data:cdao:subdomain:indices"
      ]
    },
    {
      "order": 4,
      "title": "Match: Corporate Actions Feed (ICE)",
      "description": "ICE product 'Corporate Actions Feed' (ICE-CA) ingested via EventBridge \u2192 ETL \u2192 matching engine. Retrieved 6 CDAO candidate(s).",
      "nodeIds": [
        "mds.ice:17320f3d-2679-5765-9359-646a2908c9f0",
        "etl-eventbridge",
        "match-a-parse",
        "match-b-semantic",
        "match-c-rank",
        "match-confidence-gate",
        "jpmorgan:data:cdao:concept:corporate-actions",
        "jpmorgan:data:cdao:subdomain:indices",
        "jpmorgan:data:cdao:concept:fixed-income-prices"
      ]
    },
    {
      "order": 5,
      "title": "Borderline Orchestration (Strands + Bedrock)",
      "description": "When the confidence gate lands in the 0.75\u20130.85 BORDERLINE band, the Strands Orchestrator (Claude Opus 4.8) is invoked. It reads from AgentCore Memory, dispatches a Specialist (Bedrock) to propose the target CDAO node and triples, and runs a Verifier (Bedrock) against a 10-dimension rubric. Score >=10 promotes to AUTO_MAPPED; <10 escalates to Human Review. Bedrock Evaluations captures all traces.",
      "nodeIds": [
        "match-confidence-gate",
        "orch-strands",
        "orch-agent-memory",
        "orch-specialist",
        "orch-verifier",
        "orch-evaluations",
        "hitl-review"
      ]
    },
    {
      "order": 6,
      "title": "JAPI Persist \u2014 Right Store for the Right Job",
      "description": "After a confirmed decision (PASS gate or HITL approval), the Transactional Outbox (EventBridge/SQS) fans out atomically to: Aurora (catalogue + CDAO taxonomy + lineage), Neptune (Canonical RDF + ODRL rights via SPARQL), and OpenSearch (lexical + k-NN index refresh). HITL-approved matches are published in real time to the Scudo UI via AppSync/WebSockets.",
      "nodeIds": [
        "hitl-review",
        "transactional-outbox",
        "store-aurora-catalog",
        "store-neptune",
        "store-opensearch",
        "appsync-publish"
      ]
    }
