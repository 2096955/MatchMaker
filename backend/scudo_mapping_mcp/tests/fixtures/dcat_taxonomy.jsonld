{
  "@context": {
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "ex": "https://example.com/taxonomy/"
  },
  "@graph": [
    {
      "@id": "ex:Bonds",
      "@type": "skos:Concept",
      "skos:prefLabel": "Bonds",
      "skos:broader": { "@id": "ex:FinancialData" },
      "skos:definition": "Fixed-income instruments and cash markets."
    },
    {
      "@id": "ex:FinancialData",
      "@type": "owl:Class",
      "rdfs:label": "Financial Data",
      "skos:definition": "Market and reference financial datasets."
    }
  ]
}
