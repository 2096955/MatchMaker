# ─── MarketData: externally-delivered FastAPI app — QUARANTINED ─────────
# Untracked deliverable from a separate Cognizant build (author 2493688,
# "MarketData_source_only"). Ignored wholesale pending the fold-into-host
# vs. standalone-service decision (review P2). This stops `git add .` from
# staging its bundled 159 MB venv / binaries. Un-quarantine (switch to
# scoped rules) if/when the folder is formally onboarded.
/MarketData/

# ─── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
build/
dist/

# Virtualenvs
.venv/
venv/
env/
ENV/

# ─── Node / frontend ────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ─── Editors / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs / runtime artefacts ───────────────────────────────────────────
*.log
backend/logs/
backend/uploads/
*.tmp
*.bak

# ─── Local / operational AWS state (regeneratable from CFN outputs) ─────
infra/scudo-dev-outputs.env
infra/*.env.local
.env
.env.*
!.env.example

# ─── Vendor data staging (out-of-scope for source control) ──────────────
landing_zone/
backend/uploads/

# ─── Local secrets / credentials ────────────────────────────────────────
*.pem
*.key
*credentials*
*.crt
.aws/

# ─── Workflow tool worktrees (transient agent isolation copies) ─────────
.claude/

# ─── Local tooling + debug captures (out of source control) ─────────────
.cursor/
.playwright-mcp/
.understand-anything/
data/
# Root-level debug/review screenshots from dashboard verification sessions
/*.png

# OKF bundle staging scratch (build artifact, never committed)
build/okf-src/

# Multi-agent delegation logs (council/gemini/ollama) — transient, never committed
logs/

# The OKF reproducibility kit sits under docs/okf/build/, but the blanket `build/`
# rule above would hide it. Re-include the kit (NOT the top-level build/okf-src/ scratch).
!docs/okf/build/
!docs/okf/build/stage.py
!docs/okf/build/test_stage.py
!docs/okf/build/manifest.yaml
!docs/okf/build/.gitkeep
