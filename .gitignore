# ─── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
build/
dist/
# JPMC-LOCAL: re-include the console bundle. `dist/` above is a Python
# packaging rule; it also matches frontend/dist/, which must be vendored so a
# Node-blocked desktop can run the UI. See the frontend section below.
!frontend/dist/
!frontend/dist/**

# Virtualenvs
.venv/
venv/
env/
ENV/

# ─── Node / frontend ────────────────────────────────────────────────────
node_modules/
# JPMC-LOCAL: frontend/dist/ is deliberately NOT ignored.
#
# Citrix group policy blocks node_modules/@esbuild/win32-x64/esbuild.exe, so
# `npm run dev` and `npm run build` both fail with spawn UNKNOWN and Vite
# cannot start. A vendored bundle is the only way that desktop can run the
# console UI at all — Flask serves it at /app/ with SCUDO_SERVE_FRONTEND_DIST=1
# and no Node is involved.
#
# Same precedent as dashboard-dist/, which is tracked for the same reason.
# Rebuild with:  cd frontend && npx vite build --base=/app/
# The --base is load-bearing: without it assets resolve to /assets/* and 404.
frontend/.vite/
*.tsbuildinfo

# ─── Editors / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs / runtime artefacts ───────────────────────────────────────────
*.log
backend/logs/
backend/uploads/
*.tmp
*.bak

# ─── Local / operational AWS state (regeneratable from CFN outputs) ─────
infra/scudo-dev-outputs.env
infra/*.env.local
.env
.env.*
!.env.example

# ─── Vendor data staging (out-of-scope for source control) ──────────────
landing_zone/
backend/uploads/

# ─── JPMC-LOCAL: local durable memory (STORE_BACKEND=local_file) ────────
# The precedent journal records product names/descriptions, the reviewer's
# identity and source audit ids. It is local operational state, not source,
# and must never be staged by accident.
backend/local_memory/

# ─── Local secrets / credentials ────────────────────────────────────────
*.pem
*.key
*credentials*
*.crt
.aws/

# ─── Workflow tool worktrees (transient agent isolation copies) ─────────
.claude/

# ─── Local tooling + debug captures (out of source control) ─────────────
.cursor/
.playwright-mcp/
.understand-anything/
data/
# Root-level debug/review screenshots from dashboard verification sessions
/*.png

# OKF bundle staging scratch (build artifact, never committed)
build/okf-src/

# Multi-agent delegation logs (council/gemini/ollama) — transient, never committed
logs/

# The OKF reproducibility kit sits under docs/okf/build/, but the blanket `build/`
# rule above would hide it. Re-include the kit (NOT the top-level build/okf-src/ scratch).
!docs/okf/build/
!docs/okf/build/stage.py
!docs/okf/build/test_stage.py
!docs/okf/build/manifest.yaml
!docs/okf/build/.gitkeep

# Local runtime state (SQLite fallback store, console DB) — never committed
backend/.local/
